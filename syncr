#!/usr/bin/env bash
# Syncr Android development shortcuts; run from any working directory.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ANDROID="$ROOT/code/android"
APK="$ANDROID/app/build/outputs/apk/debug/app-debug.apk"
PACKAGE="dev.syncr.prototype"
ACTIVITY="$PACKAGE/.MainActivity"

usage() {
  printf '%s\n' \
    'Usage: ./syncr COMMAND [arguments]' \
    '' \
    '  devices            List USB, wireless and emulator ADB devices' \
    '  emulator           Start the existing Medium_Phone_API_37.0 AVD (Ctrl+C to stop)' \
    '  pair               Pair Wireless debugging by QR code (scan from the phone)' \
    '  pair HOST:PORT     Pair Wireless debugging using the phone pairing port/code' \
    '  connect HOST:PORT  Connect using the phone debugging port (NOT pairing port)' \
    '  build              Rebuild the core, then build the debug APK' \
    '  test               Run Android unit tests' \
    '  check [STEP...]    Build and test everything (core bindings android mac companion); touches no device' \
    '  app_update         Rebuild the core, build, install and open the app on the selected device' \
    '  launch             Open the already-installed app' \
    '  logcat             Stream SyncrHid status and Android crashes (Ctrl+C to stop)' \
    '  logcat_errors      Stream device-wide errors/crashes (Ctrl+C to stop)' \
    '  logcat_clear       Clear device logs before a reproduction' \
    '' \
    'Use ANDROID_SERIAL=<serial> ./syncr COMMAND if multiple devices are connected.' \
    'No sudo is needed. Bluetooth drawing is separate from ADB installation.'
}

fail() { printf 'syncr: %s\n' "$*" >&2; exit 1; }
# The APK packs the core's .so as-is: rebuild it first, or a core API change ships a stale library that
# crashes at launch (UniFFI UnsatisfiedLinkError). Cargo is incremental, so an unchanged core is quick.
build_core() {
  printf 'Building the core for the phone…\n'
  ANDROID_NDK_HOME="${ANDROID_NDK_HOME:-${ANDROID_HOME:-$HOME/Library/Android/sdk}/ndk/28.2.13676358}" \
    "$ROOT/code/core/scripts/build-android.sh" arm64-v8a
}
need_adb() { command -v adb >/dev/null 2>&1 || fail 'adb not found; install Android SDK Platform-Tools or add it to PATH.'; }

# Prints HOST:PORT of the first mDNS service of type $1 (named $2 and on host $3, when given).
mdns_find() {
  adb mdns services | awk -v type="$1" -v name="$2" -v ip="$3" '
    index($0, type) && (name == "" || $1 == name) {
      a = $NF; h = a; sub(/:[0-9]+$/, "", h)
      if (ip == "" || h == ip) { print a; exit }
    }' || true
}

pair_qr() {
  need_adb
  command -v qrencode >/dev/null 2>&1 || fail 'qrencode not found; brew install qrencode.'
  local name password addr ip i
  name="ADB_WIFI_syncr-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  password="$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
  qrencode -t ansiutf8 "WIFI:T:ADB;S:$name;P:$password;;"
  printf 'On the phone: Developer options > Wireless debugging > Pair device with QR code, then scan.\n'
  addr=
  for ((i = 0; i < 90; i++)); do
    addr="$(mdns_find _adb-tls-pairing._tcp "$name" '')"
    [[ -n "$addr" ]] && break
    sleep 1
  done
  [[ -n "$addr" ]] || fail 'no phone answered the QR code; Mac and phone must be on the same Wi-Fi.'
  adb pair "$addr" "$password"
  ip="${addr%:*}"
  addr=
  for ((i = 0; i < 10; i++)); do
    addr="$(mdns_find _adb-tls-connect._tcp '' "$ip")"
    [[ -n "$addr" ]] && break
    sleep 1
  done
  if [[ -n "$addr" ]]; then adb connect "$addr"
  else printf 'Paired. Run ./syncr connect PHONE_IP:DEBUGGING_PORT\n'; fi
  adb devices -l
}

# Refuse to pick an arbitrary phone, especially when USB and Wi-Fi both show up.
select_device() {
  need_adb
  local connected
  connected="$(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')"
  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
    printf '%s\n' "$connected" | grep -Fxq -- "$ANDROID_SERIAL" || fail "ANDROID_SERIAL=$ANDROID_SERIAL is not an authorized, connected device. Run ./syncr devices."
    SERIAL="$ANDROID_SERIAL"
  elif [[ -z "$connected" ]]; then
    fail 'No authorized device found. Run ./syncr devices, start ./syncr emulator, or connect a phone.'
  elif [[ "$connected" == *$'\n'* ]]; then
    fail 'Multiple devices found. Run ./syncr devices, then ANDROID_SERIAL=<serial> ./syncr COMMAND.'
  else
    SERIAL="$connected"
  fi
}

# Everything every round should prove, in dependency order, on this machine only: no device is touched. Each step's
# output goes to a log; the summary names the failures. Android counts only fresh test results, because a compile
# failure otherwise leaves the last run's XML behind and it reads as green.
CHECK_STEPS=(core bindings android mac companion)
check_step() {
  local java=/opt/homebrew/opt/openjdk@21
  case "$1" in
    core) (cd "$ROOT/code/core" && cargo test --locked) ;;
    bindings)
      (cd "$ROOT/code/core" && JAVA_HOME="$java/libexec/openjdk.jdk/Contents/Home" scripts/generate-bindings.sh) || return 1
      # The generated bindings are committed: regenerating them must change nothing.
      local stale; stale="$(git -C "$ROOT" status --porcelain -- code/core/generated/kotlin code/core/generated/swift)"
      [[ -z "$stale" ]] || { printf 'Bindings are stale; commit the regenerated files:\n%s\n' "$stale"; return 1; }
      ;;
    android)
      build_core || return 1
      local results="$ANDROID/app/build/test-results/testDebugUnitTest"
      rm -rf "$results"
      (cd "$ANDROID" && JAVA_HOME="$java" ./gradlew --console=plain testDebugUnitTest -PsyncrNativeHost=true \
        assembleDebug assembleDebugAndroidTest) || return 1
      python3 - "$results" <<'PY'
import glob, sys, xml.etree.ElementTree as T
tests = failed = 0
for path in glob.glob(sys.argv[1] + "/*.xml"):
    r = T.parse(path).getroot(); tests += int(r.get("tests")); failed += int(r.get("failures")) + int(r.get("errors"))
print(f"Android unit tests: {tests} run, {failed} failed")
sys.exit(1 if tests == 0 or failed else 0)
PY
      ;;
    mac)
      (cd "$ROOT/code/mac" && sh prepare.sh && swift build && swift run SyncrMacChecks && swift run SyncrMacChecks --dry-cache \
        && swift run SyncrMacChecks --round2 && swift run SyncrMacChecks --companion-v2) ;;
    companion) (cd "$ROOT/code/companion" && swift build && swift run SyncrCompanionChecks) ;;
  esac
}
run_check() {
  local steps=("$@") logs="$ROOT/code/.check-logs" failed=() step start free
  [[ ${#steps[@]} -gt 0 ]] || steps=("${CHECK_STEPS[@]}")
  for step in "${steps[@]}"; do
    [[ " ${CHECK_STEPS[*]} " == *" $step "* ]] || fail "Unknown check '$step'. Steps: ${CHECK_STEPS[*]}"
  done
  free="$(df -g /System/Volumes/Data | awk 'NR == 2 { print $4 }')"
  [[ "$free" -ge 4 ]] || fail "Only ${free} GB free; builds need at least 4 GB."
  mkdir -p "$logs"
  for step in "${steps[@]}"; do
    start=$SECONDS
    printf '%-10s … ' "$step"
    if check_step "$step" >"$logs/$step.log" 2>&1; then
      printf 'ok (%ss)\n' $((SECONDS - start))
    else
      printf 'FAILED (%ss) — %s\n' $((SECONDS - start)) "$logs/$step.log"
      tail -n 15 "$logs/$step.log" | sed 's/^/    /'
      failed+=("$step")
    fi
  done
  [[ ${#failed[@]} -eq 0 ]] || fail "check failed: ${failed[*]}"
  printf 'All checks passed. Logs: %s\n' "$logs"
}

[[ $# -gt 0 ]] || { usage; exit 0; }
command="$1"
shift
case "$command" in
  help|-h|--help) usage ;;
  check) run_check "$@" ;;
  devices) [[ $# -eq 0 ]] || fail 'devices takes no arguments'; need_adb; adb devices -l ;;
  emulator)
    [[ $# -eq 0 ]] || fail 'emulator takes no arguments'
    emulator_bin="${ANDROID_HOME:-$HOME/Library/Android/sdk}/emulator/emulator"
    [[ -x "$emulator_bin" ]] || fail "Android emulator not found at $emulator_bin"
    exec "$emulator_bin" -avd Medium_Phone_API_37.0
    ;;
  pair|connect)
    if [[ "$command" == pair && $# -eq 0 ]]; then pair_qr; exit 0; fi
    [[ $# -eq 1 ]] || fail "Usage: ./syncr $command PHONE_IP:PORT"
    need_adb
    adb "$command" "$1"
    ;;
  build|test)
    [[ $# -eq 0 ]] || fail "$command takes no arguments"
    if [[ "$command" == build ]]; then build_core; fi
    (cd "$ANDROID" && ./gradlew ":app:$([[ "$command" == build ]] && printf assembleDebug || printf testDebugUnitTest)" --console=plain)
    if [[ "$command" == build ]]; then printf 'APK: %s\n' "$APK"; fi
    ;;
  app_update)
    [[ $# -eq 0 ]] || fail 'app_update takes no arguments'
    select_device
    build_core
    (cd "$ANDROID" && ./gradlew :app:assembleDebug --console=plain)
    printf '\nInstalling on %s…\n' "$SERIAL"
    adb -s "$SERIAL" install -r "$APK"
    adb -s "$SERIAL" shell am start -n "$ACTIVITY"
    printf '\nRun ./syncr logcat to watch the app.\n'
    ;;
  launch)
    [[ $# -eq 0 ]] || fail 'launch takes no arguments'
    select_device
    adb -s "$SERIAL" shell am start -n "$ACTIVITY"
    ;;
  logcat)
    [[ $# -eq 0 ]] || fail 'logcat takes no arguments'
    select_device
    printf 'Streaming SyncrHid status and AndroidRuntime crashes on %s; Ctrl+C to stop.\n' "$SERIAL"
    adb -s "$SERIAL" logcat -v time 'SyncrHid:V' 'AndroidRuntime:E' '*:S'
    ;;
  logcat_errors)
    [[ $# -eq 0 ]] || fail 'logcat_errors takes no arguments'
    select_device
    adb -s "$SERIAL" logcat -v time '*:E'
    ;;
  logcat_clear)
    [[ $# -eq 0 ]] || fail 'logcat_clear takes no arguments'
    select_device
    adb -s "$SERIAL" logcat -c
    printf 'Cleared logs on %s.\n' "$SERIAL"
    ;;
  *) fail "Unknown command '$command'. Run ./syncr help." ;;
esac
