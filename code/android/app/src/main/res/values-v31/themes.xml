<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: the page colour and the tool dot, light or dark with the system. -->
    <style name="Theme.Syncr" parent="Base.Theme.Syncr">
        <item name="android:windowSplashScreenBackground">@color/syncr_page</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>

    <style name="Theme.Syncr.Tablet" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
