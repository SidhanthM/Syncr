<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Mac link (wifi-link-v0): plain TCP to the Mac and NSD discovery; the low-latency Wi-Fi lock needs WAKE_LOCK. All normal permissions, no prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Syncr"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">
        <!-- Tablet orientation is selected in-app; rotation cancels active pad/trackpad gestures. -->
        <activity
            android:name=".PointerActivity"
            android:exported="false"
            android:label="@string/tablet_mode"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.Syncr.Tablet"
            tools:ignore="DiscouragedApi" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
